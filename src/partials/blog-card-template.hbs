<template id="tpl-blog-card">
    <article class="blog__card">
        <span class="blog__date"></span>
        <span class="blog__tag"></span>
        <h3 class="blog__title"></h3>
        <p class="blog__preview"></p>
        <div class="blog__more"><p></p></div>
        <div class="blog__actions">
            <button class="blog__read-more">Leer más →</button>
            <button class="blog__fav-btn" title="Marcar como favorito">🤍</button>
        </div>
    </article>
</template>